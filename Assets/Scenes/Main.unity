  m_Script: {fileID: 11500000, guid: 6a7becb4face0bf4fb694ce84ca4245c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CaveGame.Note
  content: "\uC5EC\uAE30\uC11C\uBD80\uD130 \uCC9C\uC7A5\uC774 \uB0AE\uC544.\n\uD5C8\uB9AC
    \uC219\uC774\uACE0 \uC640\uC57C \uD574.\n\n\uB3CC \uC313\uC744 \uC790\uB9AC\uB3C4
    \uC5C6\uC5B4\uC11C \uBCBD\uC5D0 \uC904\uC744 \uB9E4 \uB480\uC5B4. \uC5B4\uB450\uC6CC\uC11C
    \uC548 \uBCF4\uC77C \uD14C\uB2C8\uAE4C \uC190\uC73C\uB85C \uB354\uB4EC\uC73C\uBA74\uC11C
    \uB530\uB77C\uC640.\n\n\uC870\uAE08\uB9CC \uB354 \uAC00\uBA74 \uB3FC."
  font: {fileID: 11400000, guid: 100ac89b177766c4eb1a831538cd64f6, type: 2}
