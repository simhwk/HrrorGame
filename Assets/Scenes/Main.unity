--- !u!114 &185200886
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 185200882}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6a7becb4face0bf4fb694ce84ca4245c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CaveGame.Note
  content: "\uCC28\uBB34\uACBD\n\uB0A0\uC9DC \u2015 \uD655\uC778 \uBD88\uAC00\n\n\uBD84\uBA85\uD788
    \uD63C\uC790\uAC00 \uC544\uB2C8\uC5C8\uB2E4. \uCC98\uC74C\uC5D4 \uC18C\uB9AC\uB9CC
    \uB4E4\uB838\uB294\uB370 \uC774\uC81C\uB294 \uBCF4\uC778\uB2E4.\n\uB188\uB4E4\uC740
    \uD558\uB098\uAC00 \uC544\uB2C8\uC57C. \uBD88\uBE5B\uC744 \uB044\uBA74 \uAC00\uAE4C\uC774
    \uC624\uACE0, \uCF1C\uBA74 \uBA40\uC5B4\uC9C4\uB2E4.\n\uB0B4 \uB2E4\uB9AC\uB97C
    \uBB3C\uACE0\uB3C4 \uD55C\uB3D9\uC548 \uC0AC\uB78C\uCC98\uB7FC \uC11C \uC788\uC5C8\uB2E4.\n\uC81C\uBC1C
    \uB204\uAC00 \uC774\uAC78 \uCC3E\uB294\uB2E4\uBA74\u2026 \uC5EC\uAE30\uB85C \uC624\uC9C0
    \uB9C8."
  font: {fileID: 11400000, guid: 100ac89b177766c4eb1a831538cd64f6, type: 2}
