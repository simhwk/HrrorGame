MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1816773859}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7a8c327ac190a87409c4097b13641e64, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CaveGame.OpeningNote
  content: "\uC624\uB298 \uCC98\uC74C \uB3D9\uAD74\uC5D0 \uB4E4\uC5B4\uC654\uB2E4.\n\n\uCE5C\uAD6C\uAC00
    \uAC19\uC774 \uAC00\uC790\uACE0 \uD574\uC11C \uB530\uB77C\uC654\uB294\uB370,\n\uC774\uB807\uAC8C
    \uAE4A\uC740 \uACF3\uC77C \uC904\uC740 \uBAB0\uB790\uB2E4.\n\uB098\uC5D0\uAC90
    \uC774\uB7F0 \uACF3\uC774 \uCC98\uC74C\uC774\uB77C \uC870\uAE08 \uAE34\uC7A5\uB41C\uB2E4.\n\n\uCE5C\uAD6C\uAC00
    \uBA3C\uC800 \uB4E4\uC5B4\uAC00 \uAE38\uC744 \uD45C\uC2DC\uD574 \uB450\uACA0\uB2E4\uACE0
    \uD588\uB2E4.\n\uB3CC\uC774\uB098 \uC904\uC744 \uB530\uB77C\uC624\uBA74 \uB41C\uB2E4\uACE0
    \uD55C\uB2E4.\n\uB098\uB3C4 \uACE7 \uB530\uB77C\uAC00\uAE30\uB85C \uD588\uB2E4."
  font: {fileID: 0}
