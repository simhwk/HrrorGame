  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6a7becb4face0bf4fb694ce84ca4245c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CaveGame.Note
  content: "\uBC31\uD558\uB9B0\n\uB0A0\uC9DC \uBD88\uBA85 \xB7 \uAE30\uB85D \uC911\uB2E8\n\n\uB098
    \uC5EC\uAE30\uC11C \uC774\uD2C0\uC9F8\uC778\uC9C0 \uC0AC\uD758\uC9F8\uC778\uC9C0
    \uBAA8\uB974\uACA0\uC5B4.\n\uD3F0\uB3C4 \uAEBC\uC84C\uACE0, \uBC1C\uBAA9\uB3C4
    \uB2E4\uCCE4\uC5B4. \uADF8\uB7F0\uB370 \uB354 \uBB34\uC11C\uC6B4 \uAC74 \uB530\uB85C
    \uC788\uC5B4.\n\uC5EC\uAE30 \uC788\uB294 \uAC83\uB4E4\uC740 \uC0AC\uB78C \uBB3C\uAC74\uC744
    \uC8FC\uC6CC\uC11C \uC0AC\uC6A9\uD574.\n\uBA40\uB9AC\uC11C \uBCF4\uBA74 \uC0AC\uB78C\uCC98\uB7FC
    \uBCF4\uC5EC\uB3C4\u2026 \uAC00\uAE4C\uC774 \uAC00\uC9C0 \uB9C8."
  font: {fileID: 11400000, guid: 100ac89b177766c4eb1a831538cd64f6, type: 2}
