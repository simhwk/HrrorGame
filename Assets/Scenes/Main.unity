  m_Script: {fileID: 11500000, guid: 6a7becb4face0bf4fb694ce84ca4245c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CaveGame.Note
  content: "\uC724\uC11C\uC9C4\n2019. 10. 14. 15:40\n\n\uC774 \uB3D9\uAD74\uC5D0
    \uC0AC\uB78C\uC774 \uAF64 \uB9CE\uC774 \uB4E4\uC5B4\uC654\uB358 \uAC83 \uAC19\uB2E4.\n\uADF8\uB7F0\uB370
    \uC774\uC0C1\uD55C \uAC74, \uBC84\uB824\uC9C4 \uBB3C\uAC74\uB4E4\uC774 \uB108\uBB34
    \uB9CE\uB2E4\uB294 \uAC70\uB2E4.\n\uAC00\uBC29\uB3C4 \uC788\uACE0 \uC2E0\uBC1C\uB3C4
    \uC788\uACE0\u2026 \uC544\uC9C1 \uC5BC\uB9C8 \uC548 \uB41C \uAC83\uCC98\uB7FC
    \uBCF4\uC774\uB294 \uAC83\uB3C4 \uC788\uB2E4.\n\uBC29\uAE08 \uB4A4\uC5D0\uC11C
    \uB204\uAC00 \uB530\uB77C\uC624\uB294 \uC18C\uB9AC\uAC00 \uB0AC\uB2E4."
  font: {fileID: 0}
