# Unity generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data for ignored folders
!/[Aa]ssets/**/*.meta

# Visual Studio / Rider / VS Code
.vs/
.idea/
.vscode/
.vsconfig
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# Gradle cache
.gradle/

# PPT generator (docs/)
build/node_modules/
build/*.pdf
build/deck.pptx

# OS
.DS_Store
Thumbs.db
desktop.ini
*.slnx

# Local backups/exports (too large for repo)
*.zip

# MCP 디버그 캡처 (에디터 도구 산출물)
/[Aa]ssets/[Ss]creenshots/
/[Aa]ssets/[Ss]creenshots.meta
/[Cc]aptures/

# 플레이어 빌드 결과물 (build/의 PPT 생성 스크립트만 추적)
/build/*
!/build/gen_ppt.js
!/build/package.json
!/build/package-lock.json
